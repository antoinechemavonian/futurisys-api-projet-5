# Copier ce fichier en .env puis remplacer les valeurs. Ne JAMAIS committer le fichier .env.
POSTGRES_USER=futurisys
POSTGRES_PASSWORD=changez-moi
POSTGRES_DB=futurisys
# Clé exigée dans l'en-tête X-API-Key (laisser vide = pas d'authentification, dev uniquement)
API_KEY=changez-moi-aussi
# Utilisée hors Docker (lancement local avec uvicorn)
DATABASE_URL=postgresql+psycopg2://futurisys:changez-moi@localhost:5432/futurisys
